{
	"name": "urlx",
	"private": true,
	"description": "Free and open-source URL tools built for Bun and PostgreSQL.",
	"license": "MIT",
	"author": "Chames Eddine Dhibi (https://v1.chames.dhibi.tn)",
	"contributors": [
		"Chames Eddine Dhibi (https://v1.chames.dhibi.tn)",
		"Youssef Dhibi (https://youssef.tn)"
	],
	"homepage": "https://www.urlx.tn",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/urlx-tn/URLX.git"
	},
	"bugs": {
		"url": "https://github.com/urlx-tn/URLX/issues"
	},
	"keywords": [
		"url-tools",
		"url-shortener",
		"url-cleaner",
		"url-metadata",
		"url-to-html",
		"url-to-markdown",
		"qr-code",
		"link-in-bio",
		"cloudflare-workers",
		"open-source"
	],
	"engines": {
		"node": ">=22.18"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"type": "module",
	"scripts": {
		"dev": "pnpm --filter web dev:bare",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"test": "bun test deploy/entrypoints/start-web.test.ts && turbo run test --concurrency=1",
		"dev:web": "pnpm --filter web dev:bare",
		"dev:api": "pnpm --filter server exec bun src/main-api.ts",
		"dev:conversion": "pnpm --filter server exec bun src/main-conversion.ts",
		"db:generate": "pnpm --filter @urlx/db db:generate",
		"db:migrate": "pnpm --filter @urlx/db db:migrate",
		"containers:preflight": "bash scripts/check-compose-config.sh",
		"containers:build": "docker compose build",
		"containers:up": "pnpm containers:preflight && pnpm containers:build && pnpm egress:prepare",
		"containers:down": "bash scripts/remove-egress-gate.sh",
		"containers:logs": "docker compose logs -f",
		"egress:prepare": "bash scripts/prepare-egress-gate.sh --apply",
		"check": "biome check .",
		"check:write": "biome check --write ."
	},
	"dependencies": {
		"@urlx/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"pnpm": {
		"overrides": {
			"@esbuild-kit/core-utils>esbuild": "^0.25.0",
			"@vitest/mocker": "^4.1.12",
			"source-map-js": "^1.2.2",
			"better-auth@1.7.10>drizzle-kit": "-"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@cloudflare/workers-types": "catalog:",
		"@playwright/test": "^1.64.1",
		"@types/node": "catalog:",
		"@urlx/config": "workspace:*",
		"turbo": "^2.10.12",
		"typescript": "catalog:"
	},
	"packageManager": "pnpm@10.22.0"
}
