{
	"name": "@urlx/db",
	"type": "module",
	"exports": {
		".": {
			"default": "./src/index.ts"
		},
		"./*": {
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"check-types": "tsc --noEmit --pretty false",
		"test": "bun test ./scripts",
		"db:generate": "drizzle-kit generate --config=drizzle.config.ts",
		"db:migrate": "bun ./scripts/migrate.ts",
		"db:import-sqlite": "bun ./scripts/import-sqlite-to-postgres.ts",
		"test:migrate": "bun test ./scripts/migrate.test.ts",
		"test:import-sqlite": "bun test ./scripts/import-sqlite-to-postgres.test.ts"
	},
	"dependencies": {
		"drizzle-orm": "^0.45.1",
		"pg": "^8.16.3",
		"zod": "catalog:"
	},
	"devDependencies": {
		"bun-types": "catalog:",
		"@urlx/config": "workspace:*",
		"@types/pg": "catalog:",
		"drizzle-kit": "^0.31.8",
		"typescript": "catalog:"
	}
}
