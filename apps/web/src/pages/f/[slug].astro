---
import logoAccent from "../../assets/logo-layer-accent.png";
import logoInk from "../../assets/logo-layer-ink.png";
import Layout from "../../layouts/Layout.astro";
import "../../styles/forms.css";
import { env } from "cloudflare:workers";
import { proxyApiRequest } from "../../lib/api-proxy";
import { formsReady } from "../../lib/forms-ready";
import { accentColors, formsIcon, publicFieldMarkup } from "../../lib/forms-ui";

export const prerender = false;
const { slug = "" } = Astro.params;
const formsEnabled = formsReady(
	env as typeof env & Parameters<typeof formsReady>[0],
);
Astro.response.headers.set("Cache-Control", "no-store");
type PublicForm = {
	form?: Record<string, any>;
	version?: Record<string, any>;
	submissionToken?: string;
	idempotencyKey?: string;
};
let result: PublicForm | null = null;
let unavailable = false;
if (formsEnabled && slug) {
	try {
		const response = await proxyApiRequest(
			Astro.request,
			`/api/forms/public/${encodeURIComponent(slug)}`,
		);
		if (response.ok) result = (await response.json()) as PublicForm;
		else if (response.status === 404) Astro.response.status = 404;
		else unavailable = true;
	} catch {
		unavailable = true;
	}
}
const canonicalSlug = result?.form?.canonicalSlug;
if (canonicalSlug && canonicalSlug !== slug)
	return Astro.redirect(`/f/${encodeURIComponent(canonicalSlug)}`, 308);
const form = result?.form;
const version = result?.version;
const versionData =
	version?.draft && typeof version.draft === "object" ? version.draft : version;
const fields = Array.isArray(version?.fields)
	? version.fields
	: Array.isArray(versionData?.fields)
		? versionData.fields
		: Array.isArray(form?.fields)
			? form.fields
			: [];
const title = form?.title || versionData?.title || "Form";
const description = versionData?.description || form?.description || "";
const confirmationMessage =
	form?.confirmationMessage ||
	versionData?.confirmationMessage ||
	"Your response has been recorded.";
const submitted = Astro.url.searchParams.get("submitted") === "1";
// Only allowlisted accent ids reach the page; `theme` is a light/dark mode, not a colour.
const accentValue =
	(accentColors as Record<string, string>)[
		String(versionData?.accent || form?.accent || "blue")
	] ?? accentColors.blue;
const submitVersion = version?.id ?? "";
const submitToken = result?.submissionToken ?? "";
const idempotencyKey = result?.idempotencyKey ?? "";
const pageTitle = `${title} | URLX Forms`;
const hasRequired = fields.some(
	(field: Record<string, unknown>) => field.required,
);
const minutes = Math.max(1, Math.ceil((fields.length * 20) / 60));
---
<Layout title={pageTitle} description={description || `Fill out ${title} online.`} image={form && canonicalSlug ? `/api/forms/public/${encodeURIComponent(canonicalSlug)}/og.png` : undefined} imageAlt={`${title} form preview`} canonicalPath={`/f/${slug}`} chrome={false} clientRouter={false}>
	<div class="forms-app" style={`--form-accent:${accentValue}`}>
		{formsEnabled && form && version ? (
			<div class:list={["f-public", { "is-done": submitted }]}>
				<div class="f-cover" aria-hidden="true"></div>
				<a class="f-cover-brand" href="/tools/forms" aria-label="Made with URLX Forms">
					<span class="f-logo" aria-hidden="true"><span class="ink" style={`--logo:url("${logoInk.src}")`}></span><span class="accent" style={`--logo:url("${logoAccent.src}")`}></span></span>
					<span>Forms</span>
				</a>
				{!submitted && <div class="f-progress" hidden aria-hidden="true"><span></span></div>}
				<main class="f-public-card">
					{submitted ? (
						<section class="f-thanks" role="status">
							<span class="f-thanks-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span>
							<h1>Thank you</h1>
							<p class="f-thanks-message">{confirmationMessage}</p>
							<a class="f-thanks-again" href={`/f/${encodeURIComponent(slug)}`}>Submit another response</a>
						</section>
					) : <>
					<header class="f-public-head">
						<h1>{title}</h1>
						{description && <p>{description}</p>}
						<p class="f-public-meta"><Fragment set:html={formsIcon("forms", 15)} /><span>{fields.length} question{fields.length === 1 ? "" : "s"}</span><Fragment set:html={formsIcon("clock", 15)} /><span>About {minutes} min</span>{hasRequired && <span class="f-required-note"><span class="f-req">*</span> Required</span>}</p>
					</header>
					<form method="post" action={`/f/${encodeURIComponent(slug)}/submit`} class="f-public-form">
						<input type="hidden" name="versionId" value={submitVersion} />
						<input type="hidden" name="submissionToken" value={submitToken} />
						<input type="hidden" name="idempotencyKey" value={idempotencyKey} />
						<div hidden aria-hidden="true"><label>Leave this field empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
						<div class="f-public-fields" set:html={fields.map((field: Record<string, any>, index: number) => publicFieldMarkup(field, index)).join("")} />
						<div class="f-public-footer">
							<button class="f-btn" type="submit">Submit</button>
							<p class="f-public-progress" hidden aria-live="polite"></p>
							<p class="f-public-safety">Never share passwords or payment details in a form.</p>
						</div>
					</form>
					</>}
				</main>
				<footer class="f-made">
					<a class="f-made-cta" href="/tools/forms">Create your own form with URLX <span aria-hidden="true">→</span></a>
				</footer>
			</div>
		) : (
			<main class="forms-main" style="padding-top:100px;text-align:center">
				<div class="f-card f-empty"><h1>{!formsEnabled ? "Forms are not available" : unavailable ? "This form is temporarily unavailable" : "Form not found"}</h1><p>{!formsEnabled ? "URLX Forms has not been enabled for this deployment." : unavailable ? "Please try again in a little while." : "This form may have been removed or the link may be incorrect."}</p>{unavailable && <a class="f-btn secondary" href={`/f/${encodeURIComponent(slug)}`}>Try again</a>}</div>
			</main>
		)}
	</div>
	<script>
		// @ts-nocheck
		// Progress bar is an enhancement: the form submits fine without it.
		const form = document.querySelector(".f-public-form");
		const bar = document.querySelector(".f-progress");
		const label = document.querySelector(".f-public-progress");
		if (form && bar && label) {
			const questions = [...form.querySelectorAll(".f-public-field")];
			const answered = (field) =>
				[...field.querySelectorAll("input, textarea")].some((input) =>
					input.type === "radio" || input.type === "checkbox" ? input.checked : input.value.trim() !== "",
				);
			const update = () => {
				const done = questions.filter(answered).length;
				bar.querySelector("span").style.width = `${questions.length ? (done / questions.length) * 100 : 0}%`;
				label.textContent = `${done} of ${questions.length} answered`;
			};
			bar.hidden = false;
			label.hidden = false;
			form.addEventListener("input", update);
			form.addEventListener("change", update);
			update();
		}
	</script>
</Layout>
