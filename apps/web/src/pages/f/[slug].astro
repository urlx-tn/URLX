---
import Layout from "../../layouts/Layout.astro";
import "../../styles/forms.css";
import { env } from "cloudflare:workers";
import { proxyApiRequest } from "../../lib/api-proxy";
import { formsReady } from "../../lib/forms-ready";
import { accentColors, publicFieldMarkup } from "../../lib/forms-ui";

export const prerender = false;
const { slug = "" } = Astro.params;
const formsEnabled = formsReady(
	env as typeof env & Parameters<typeof formsReady>[0],
);
Astro.response.headers.set("Cache-Control", "no-store");
type PublicForm = {
	form?: Record<string, any>;
	version?: Record<string, any>;
	submissionToken?: string;
	idempotencyKey?: string;
};
let result: PublicForm | null = null;
let unavailable = false;
if (formsEnabled && slug) {
	try {
		const response = await proxyApiRequest(
			Astro.request,
			`/api/forms/public/${encodeURIComponent(slug)}`,
		);
		if (response.ok) result = (await response.json()) as PublicForm;
		else if (response.status === 404) Astro.response.status = 404;
		else unavailable = true;
	} catch {
		unavailable = true;
	}
}
const canonicalSlug = result?.form?.canonicalSlug;
if (canonicalSlug && canonicalSlug !== slug)
	return Astro.redirect(`/f/${encodeURIComponent(canonicalSlug)}`, 308);
const form = result?.form;
const version = result?.version;
const versionData =
	version?.draft && typeof version.draft === "object" ? version.draft : version;
const fields = Array.isArray(version?.fields)
	? version.fields
	: Array.isArray(versionData?.fields)
		? versionData.fields
		: Array.isArray(form?.fields)
			? form.fields
			: [];
const title = form?.title || versionData?.title || "Form";
const description = versionData?.description || form?.description || "";
const confirmationMessage =
	form?.confirmationMessage ||
	versionData?.confirmationMessage ||
	"Thank you for your response.";
const submitted = Astro.url.searchParams.get("submitted") === "1";
// Only allowlisted accent ids reach the page; `theme` is a light/dark mode, not a colour.
const accentValue =
	(accentColors as Record<string, string>)[
		String(versionData?.accent || form?.accent || "blue")
	] ?? accentColors.blue;
const submitVersion = version?.id ?? "";
const submitToken = result?.submissionToken ?? "";
const idempotencyKey = result?.idempotencyKey ?? "";
const pageTitle = `${title} | URLX Forms`;
const hasRequired = fields.some(
	(field: Record<string, unknown>) => field.required,
);
---
<Layout title={pageTitle} description={description || `Fill out ${title} online.`} image={form && canonicalSlug ? `/api/forms/public/${encodeURIComponent(canonicalSlug)}/og.png` : undefined} imageAlt={`${title} form preview`} canonicalPath={`/f/${slug}`} chrome={false} clientRouter={false}>
	<div class="forms-app" style={`--form-accent:${accentValue}`}>
		{formsEnabled && form && version ? (
			<div class="f-public">
				<main class="f-public-card">
					<div class="f-band"></div>
					{submitted ? <section class="f-public-head f-thanks" role="status"><span class="f-thanks-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12.5 4.5 4.5L19 7.5" /></svg></span><h1>Thank you</h1><p>{confirmationMessage}</p></section> : <>
					<header class="f-public-head"><h1>{title}</h1>{description && <p>{description}</p>}{hasRequired && <p class="f-required-note"><span class="f-req">*</span> Required</p>}</header>
					<form method="post" action={`/f/${encodeURIComponent(slug)}/submit`}>
						<input type="hidden" name="versionId" value={submitVersion} />
						<input type="hidden" name="submissionToken" value={submitToken} />
						<input type="hidden" name="idempotencyKey" value={idempotencyKey} />
						<div hidden aria-hidden="true"><label>Leave this field empty<input name="website" tabindex="-1" autocomplete="off" /></label></div>
						<div class="f-public-fields" set:html={fields.map((field: Record<string, any>, index: number) => publicFieldMarkup(field, index)).join("")} />
						<div class="f-public-footer"><button class="f-btn" type="submit">Submit</button></div>
					</form>
					</>}
				</main>
				<p class="f-brand-foot">Made with <a href="/tools/forms">URLX Forms</a> · <a href="/tools/forms">Create your own form</a></p>
			</div>
		) : (
			<main class="forms-main" style="padding-top:100px;text-align:center">
				<div class="f-card f-empty"><h1>{!formsEnabled ? "Forms are not available" : unavailable ? "This form is temporarily unavailable" : "Form not found"}</h1><p>{!formsEnabled ? "URLX Forms has not been enabled for this deployment." : unavailable ? "Please try again in a little while." : "This form may have been removed or the link may be incorrect."}</p>{unavailable && <a class="f-btn secondary" href={`/f/${encodeURIComponent(slug)}`}>Try again</a>}</div>
			</main>
		)}
	</div>
</Layout>
