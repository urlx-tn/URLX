---
import FormsHeader from "../../components/forms/FormsHeader.astro";
import Layout from "../../layouts/Layout.astro";
import "../../styles/forms.css";
import { env } from "cloudflare:workers";
import { formsReady } from "../../lib/forms-ready";
import { formsIcon } from "../../lib/forms-ui";

const { id } = Astro.params;
const formsEnabled = formsReady(
	env as typeof env & Parameters<typeof formsReady>[0],
);
const title = "Edit form | URLX Forms";
---
<Layout title={title} description="Edit, publish and manage your URLX form." canonicalPath={`/forms/${id}`} chrome={false} clientRouter={false}>
	<div class="forms-app" data-form-id={id} data-enabled={String(formsEnabled)} inert={formsEnabled} aria-busy={formsEnabled ? "true" : undefined}>
		<FormsHeader />
		{!formsEnabled && <main class="forms-main" style="padding-top:100px;text-align:center"><div class="f-card f-empty"><h1>URLX Forms is not enabled</h1><p>This feature has not been configured for this deployment.</p></div></main>}
		{formsEnabled && <>
		<main class="forms-main wide">
			<h1 class="f-sr">Form builder</h1>
			<div class="f-toolbar">
				<div class="f-toolbar-top">
					<a class="f-icon-btn" href="/forms" aria-label="Back to my forms" set:html={formsIcon("back", 18)} />
					<div class="f-toolbar-heading">
						<span class="f-toolbar-title" id="form-title-label">Loading form…</span>
						<span id="form-save-state" class="f-save-state" aria-live="polite"></span>
					</div>
				</div>
				<div class="f-toolbar-bottom">
					<div class="f-tabs" role="tablist" aria-label="Form sections">
						<button type="button" id="build-tab" data-tab="build" role="tab" aria-controls="build-panel" aria-selected="true" tabindex="0"><Fragment set:html={formsIcon("forms", 16)} />Build</button>
						<button type="button" id="share-tab" data-tab="share" role="tab" aria-controls="share-panel" aria-selected="false" tabindex="-1"><Fragment set:html={formsIcon("link", 16)} />Share</button>
						<button type="button" id="responses-tab" data-tab="responses" role="tab" aria-controls="responses-panel" aria-selected="false" tabindex="-1"><Fragment set:html={formsIcon("inbox", 16)} />Responses <span id="response-count" class="f-count">0</span></button>
					</div>
					<div class="f-toolbar-actions"><span class="f-history"><button class="f-icon-btn" type="button" data-action="undo" title="Undo (Ctrl+Z)" aria-label="Undo" set:html={formsIcon("undo", 17)} /><button class="f-icon-btn" type="button" data-action="redo" title="Redo (Ctrl+Shift+Z)" aria-label="Redo" set:html={formsIcon("redo", 17)} /></span><button class="f-btn secondary small" type="button" data-action="preview"><Fragment set:html={formsIcon("eye", 16)} />Preview</button><button class="f-btn small" type="button" data-action="publish"><Fragment set:html={formsIcon("send", 15)} />Publish</button></div>
				</div>
			</div>
			<div id="editor-alert" class="f-notice" hidden></div>
			<section id="build-panel" data-panel="build" role="tabpanel" aria-labelledby="build-tab" tabindex="0">
				<div class="f-editor-grid">
					<div class="f-canvas"><div class="f-paper" id="form-paper"><div class="f-band"></div><div class="f-paper-head"><input id="draft-title" value="" aria-label="Form title" placeholder="Untitled form"><textarea id="draft-description" aria-label="Form description" placeholder="Add a description (optional)" rows="2"></textarea></div><div id="question-list"></div><div class="f-paper-foot" id="paper-add"></div></div></div>
					<aside class="f-sidebar" aria-label="Form editor controls">
						<section class="f-card"><h2><span class="f-h-icon" set:html={formsIcon("plus", 15)} />Add a question</h2><div class="f-types" id="field-types"></div></section>
						<section class="f-card f-settings"><h2><span class="f-h-icon" set:html={formsIcon("palette", 15)} />Appearance</h2><span class="f-label">Accent colour</span><div id="draft-accent" class="f-accent-swatches" role="group" aria-label="Form accent colour"></div><p class="f-muted f-fine">Changes save automatically.</p></section>
					<section class="f-card f-settings"><h2><span class="f-h-icon" set:html={formsIcon("check", 15)} />After submitting</h2><label class="f-label" for="draft-confirmation">Message people see</label><textarea id="draft-confirmation" class="f-textarea f-confirm-input" maxlength="500" rows="3" placeholder="Your response has been recorded."></textarea><p class="f-muted f-fine">Shown under “Thank you”. Publish again to update the live form.</p></section>
						<section class="f-card"><h2><span class="f-h-icon" set:html={formsIcon("keyboard", 15)} />Shortcuts</h2><div class="f-keyline"><span>Undo / redo</span><span><kbd>Ctrl</kbd><kbd>Z</kbd></span></div><div class="f-keyline"><span>Duplicate question</span><span><kbd>Ctrl</kbd><kbd>D</kbd></span></div><div class="f-keyline"><span>Move question</span><span><kbd>Alt</kbd><kbd>↑</kbd><kbd>↓</kbd></span></div><div class="f-keyline"><span>New question below</span><span><kbd>Enter</kbd></span></div></section>
					</aside>
				</div>
			</section>
			<section data-panel="share" role="tabpanel" hidden id="share-panel" aria-labelledby="share-tab" tabindex="0"></section>
			<section data-panel="responses" role="tabpanel" hidden id="responses-panel" aria-labelledby="responses-tab" tabindex="0"></section>
		</main>
		<dialog id="preview-dialog" class="f-preview-dialog" aria-labelledby="preview-title"><div class="f-preview-tools"><span id="preview-title"><Fragment set:html={formsIcon("eye", 17)} />Preview</span><div class="f-tabs"><button type="button" data-action="preview-device" data-device="desktop" aria-pressed="true">Desktop</button><button type="button" data-action="preview-device" data-device="phone" aria-pressed="false">Phone</button></div></div><div id="preview-content"></div><form method="dialog" class="f-preview-close"><button class="f-btn secondary">Close preview</button></form></dialog>
		</>}
	</div>
	<script>
		// @ts-nocheck
		import { formsRequest, normalizeDraft, type FormDraft, type FormField } from "../../lib/forms-api";
		import { accentColors, fieldTypeMeta, fieldTypeOrder, formsIcon as icon, previewFormMarkup } from "../../lib/forms-ui";
		import { chooseRespondentAccess, confirmAction, errorMessage, showToast } from "../../lib/forms-dialog";
		import { renderQrPngDataUrl, renderQrSvg } from "../../lib/qr-code";
		const app = document.querySelector(".forms-app");
		if (app?.dataset.enabled === "true") {
		app.inert = true;
		app.setAttribute("aria-busy", "true");
		const formId = app.dataset.formId;
		const types = fieldTypeOrder;
		const typeNames = Object.fromEntries(types.map((type) => [type, fieldTypeMeta[type].name]));
		const colors = accentColors;
		const isChoice = (type) => type === "singlechoice" || type === "multichoice";
		const localKey = `urlx-form-draft:${formId}`;
		const $ = (selector) => app.querySelector(selector);
		const esc = (value) => String(value ?? "").replace(/[&<>"']/g, (c) => ({ "&":"&amp;", "<":"&lt;", ">":"&gt;", '"':"&quot;", "'":"&#39;" })[c]);
		const clone = (value) => JSON.parse(JSON.stringify(value));
		const newField = (type) => ({ id: crypto.randomUUID(), type, label: "Question", help: "", required: false, options: ["Option 1", "Option 2"] });
		let draft = { title:"Untitled form", description:"", accent:"blue", fields:[] };
		let revision = 0;
		let responses = [];
		let stats = {};
		let responseTotal = 0;
		let responsesView = "summary";
		let selected = "";
		let activeTab = "build";
		let saveTimer;
		let localOnly = false;
		let editVersion = 0;
		let savedVersion = 0;
		let savePromise = null;
		let pendingConflict = null;
		let history = [];
		let historyIndex = -1;
		let historyTimer;
		let currentForm = {};
		let pendingRespondentAccess = null;
		let shareUrl = "";
		let shortUrl = "";
		function color() { return colors[draft.accent] || draft.accent || colors.blue; }
		function setSaveState(state, text) { const node = $("#form-save-state"); node.dataset.state = state; node.textContent = text; }
		function syncHistoryButtons() { const undo = $('[data-action="undo"]'); const redo = $('[data-action="redo"]'); if (undo) undo.disabled = historyIndex <= 0; if (redo) redo.disabled = historyIndex >= history.length - 1; }
		function snapshot() { const next = JSON.stringify(draft); if (history[historyIndex] === next) return; history = history.slice(0, historyIndex + 1); history.push(next); if (history.length > 80) history.shift(); historyIndex = history.length - 1; syncHistoryButtons(); }
		function capturePendingText() {
			draft.title = $("#draft-title").value;
			draft.description = $("#draft-description").value;
			draft.confirmationMessage = $("#draft-confirmation").value;
			for (const card of app.querySelectorAll("[data-field]")) {
				const field = draft.fields.find((item) => item.id === card.dataset.field);
				if (!field) continue;
				for (const input of card.querySelectorAll("input[data-key], textarea[data-key]")) {
					if (input.dataset.key === "label") field.label = input.value;
					if (input.dataset.key === "help") field.help = input.value;
					if (input.dataset.key === "option") field.options[Number(input.dataset.option)] = input.value;
				}
			}
		}
		function edit(mutator, structure = false) { if (structure) { clearTimeout(historyTimer); capturePendingText(); snapshot(); } mutator(); render(); if (structure) snapshot(); queueSave(); }
		function cacheDraft() { try { localStorage.setItem(localKey, JSON.stringify({ draft, revision, editVersion })); } catch {} }
		function showLocalSaveState(message = "Your changes are stored in this browser. They’ll sync when the connection returns.") {
			localOnly = true;
			setSaveState("local", "Saved on this device");
			const alert = $("#editor-alert"); alert.hidden = false; alert.textContent = message;
		}
		function showConflict(remoteDraft, remoteRevision, message = "This form changed elsewhere. Reload the latest version, or keep your changes and overwrite it.") {
			pendingConflict = { draft:normalizeDraft(remoteDraft), revision:remoteRevision };
			const alert = $("#editor-alert");
			alert.hidden = false;
			alert.setAttribute("role", "alert");
			alert.innerHTML = `${esc(message)} <button type="button" class="f-btn secondary small" data-action="resolve-conflict" data-resolution="reload">Reload latest</button> <button type="button" class="f-btn small" data-action="resolve-conflict" data-resolution="overwrite">Keep my changes and overwrite</button>`;
			setSaveState("conflict", "Conflict");
		}
		function queueSave() {
			editVersion++;
			clearTimeout(saveTimer);
			clearTimeout(historyTimer);
			historyTimer = setTimeout(snapshot, 450);
			cacheDraft();
			if (pendingConflict) return;
			setSaveState("saving", "Saving…");
			saveTimer = setTimeout(() => { void flushDraft(); }, 550);
		}
		async function flushDraft() {
			clearTimeout(saveTimer);
			saveTimer = undefined;
			if (pendingConflict) return false;
			if (savePromise) return savePromise;
			if (savedVersion >= editVersion) return true;
			if (!navigator.onLine) { showLocalSaveState(); return false; }
			savePromise = (async () => {
				let attemptedVersion = 0;
				try {
					while (savedVersion < editVersion) {
						const savingVersion = editVersion;
						attemptedVersion = savingVersion;
						const body = JSON.stringify({ draft:clone(draft), revision });
						const result = await formsRequest<{ draft?: unknown; revision?: number }>(`/${encodeURIComponent(formId)}/draft`, { method:"PUT", body });
						revision = result.revision ?? revision;
						savedVersion = savingVersion;
						if (savedVersion === editVersion) {
							localOnly = false;
							try { localStorage.removeItem(localKey); } catch {}
						} else cacheDraft();
					}
					localOnly = false;
					const alert = $("#editor-alert");
					if (!pendingConflict) alert.hidden = true;
					setSaveState("saved", "Saved");
					return true;
				} catch (error) {
					const data = error && typeof error === "object" ? error.data : null;
					if (error?.status === 409 && data?.draft && Number.isInteger(data.revision)) {
						showConflict(data.draft, data.revision);
						return false;
					}
					showLocalSaveState(error instanceof Error && error.message ? `Could not save your changes. They are stored in this browser. ${error.message}` : undefined);
					if (editVersion > attemptedVersion && navigator.onLine && saveTimer === undefined)
						saveTimer = setTimeout(() => { void flushDraft(); }, 550);
					return false;
				} finally {
					savePromise = null;
				}
			})();
			return savePromise;
		}
		async function resolveConflict(resolution) {
			if (!pendingConflict) return;
			const observedRevision = pendingConflict.revision;
			try {
				const latest = await formsRequest<{ form?: FormRecord; draft?: unknown; revision?: number }>(`/${encodeURIComponent(formId)}`);
				const latestDraft = normalizeDraft(latest.draft || latest.form?.draft || latest.form, latest.form?.title || "Untitled form");
				const latestRevision = latest.revision ?? 0;
				if (resolution === "overwrite" && latestRevision !== observedRevision) {
					showConflict(latestDraft, latestRevision, "This form changed again. Review the latest version before overwriting it.");
					return;
				}
				pendingConflict = null;
				revision = latestRevision;
				if (resolution === "reload") {
					draft = latestDraft;
					editVersion = savedVersion = 0;
					try { localStorage.removeItem(localKey); } catch {}
					history = []; historyIndex = -1; snapshot(); render();
					localOnly = false;
					$("#editor-alert").hidden = true;
					setSaveState("saved", "Saved");
					return;
				}
				queueSave();
				await flushDraft();
			} catch (error) {
				if (pendingConflict) showConflict(pendingConflict.draft, pendingConflict.revision, error instanceof Error && error.message ? `Could not check the latest version. ${error.message}` : "Could not check the latest version.");
			}
		}
		window.addEventListener("online", () => {
			const retryLocalDraft = () => { if (localOnly && !pendingConflict) void flushDraft(); };
			if (savePromise) {
				void savePromise.then(retryLocalDraft);
				return;
			}
			retryLocalDraft();
		});
		const previewText = { short:"Short answer text", paragraph:"Long answer text", email:"name@example.com", phone:"+1 555 010 0000", number:"0", date:"dd / mm / yyyy" };
		function fieldPreview(field) {
			if (isChoice(field.type)) return "";
			if (field.type === "rating") return `<div class="q-stars" aria-hidden="true">${[1, 2, 3, 4, 5].map(() => icon("rating", 26)).join("")}</div>`;
			const glyph = field.type === "short" || field.type === "paragraph" ? "" : icon(field.type, 16);
			return `<div class="q-preview ${field.type === "paragraph" ? "tall" : ""}" aria-hidden="true">${glyph}<span>${previewText[field.type] || "Short answer text"}</span></div>`;
		}
		function typeBadge(type) { const meta = fieldTypeMeta[type] || fieldTypeMeta.short; return `<span class="f-type-badge">${icon(type in fieldTypeMeta ? type : "short", 14)}${esc(meta.name)}</span>`; }
		function questionCard(field, index) {
			const options = isChoice(field.type) ? `<div class="q-options">${(field.options || []).map((option, optionIndex) => `<div class="q-option"><span class="q-mark ${field.type === "singlechoice" ? "radio" : "check"}" aria-hidden="true"></span><input data-key="option" data-option="${optionIndex}" value="${esc(option)}" aria-label="Option ${optionIndex + 1}"><button type="button" data-action="remove-option" data-option="${optionIndex}" aria-label="Remove option" title="Remove option" class="f-icon-btn danger-hover">${icon("close", 15)}</button></div>`).join("")}<button type="button" data-action="add-option" class="q-add-option">${icon("plus", 15)}Add option</button></div>` : "";
			const last = index === draft.fields.length - 1;
			return `<article class="f-question ${selected === field.id ? "selected" : ""}" data-field="${esc(field.id)}"><div class="q-head"><span class="q-num">${index + 1}</span>${typeBadge(field.type)}</div><div class="q-label-row"><input class="q-label" data-key="label" value="${esc(field.label)}" placeholder="Question ${index + 1}" aria-label="Question ${index + 1}"><strong class="q-asterisk" aria-hidden="true" ${field.required ? "" : "hidden"}>*</strong></div><input class="q-help" data-key="help" value="${esc(field.help)}" placeholder="Add a hint (optional)" aria-label="Question hint">${fieldPreview(field)}${options}<div class="f-q-actions"><label class="q-type-select"><span class="f-sr">Question type</span><select data-action="type-select" aria-label="Question type">${types.map((type) => `<option value="${type}" ${field.type === type ? "selected" : ""}>${typeNames[type]}</option>`).join("")}</select></label><button type="button" class="q-switch" data-action="required" aria-pressed="${field.required}"><span class="q-switch-track" aria-hidden="true"></span>Required</button><span class="q-spacer"></span><button type="button" data-action="up" aria-label="Move up" title="Move up" ${index === 0 ? "disabled" : ""}>${icon("up", 17)}</button><button type="button" data-action="down" aria-label="Move down" title="Move down" ${last ? "disabled" : ""}>${icon("down", 17)}</button><button type="button" data-action="duplicate" aria-label="Duplicate question" title="Duplicate (Ctrl+D)">${icon("copy", 16)}</button><button type="button" class="danger" data-action="delete" aria-label="Delete question" title="Delete">${icon("trash", 16)}</button></div></article>`;
		}
		function renderStatic() {
			const groups = [...new Set(types.map((type) => fieldTypeMeta[type].group))];
			$("#field-types").innerHTML = groups.map((group) => `<p class="f-type-group">${esc(group)}</p>${types.filter((type) => fieldTypeMeta[type].group === group).map((type) => `<button type="button" class="f-type-tile" data-action="add" data-type="${type}"><span class="f-type-icon">${icon(type, 16)}</span><span class="f-type-text"><strong>${esc(fieldTypeMeta[type].name)}</strong><small>${esc(fieldTypeMeta[type].hint)}</small></span></button>`).join("")}`).join("");
			$("#paper-add").innerHTML = `<span class="f-muted">Add</span>${["short", "paragraph", "singlechoice", "multichoice", "rating"].map((type) => `<button type="button" class="f-quick-add" data-action="add" data-type="${type}" aria-label="Add ${esc(typeNames[type])} question" title="${esc(typeNames[type])}">${icon(type, 16)}</button>`).join("")}`;
		}
		function render() {
			$("#form-title-label").textContent = draft.title || "Untitled form";
			$("#draft-title").value = draft.title || "";
			$("#draft-description").value = draft.description || "";
			if (document.activeElement !== $("#draft-confirmation")) $("#draft-confirmation").value = draft.confirmationMessage || "";
			$("#form-paper").style.setProperty("--form-accent", color());
			$("#draft-accent").innerHTML = Object.entries(colors).map(([name, value]) => `<button type="button" data-action="accent" data-accent="${name}" aria-label="${name} accent" title="${name[0].toUpperCase()}${name.slice(1)}" aria-pressed="${draft.accent === name}" style="--swatch:${value}">${icon("check", 15)}</button>`).join("");
			const questionHint = `<p class="f-question-hint">Edit a question directly, or select it for more options.</p>`;
			$("#question-list").innerHTML = draft.fields.length ? `${questionHint}${draft.fields.map(questionCard).join("")}` : `<div class="f-paper-empty"><span class="f-empty-icon">${icon("plus", 24)}</span><h2>Start with your first question</h2><p>Choose a type in Add a question, or use the quick-add buttons at the bottom of this form.</p></div>`;
			$("#response-count").textContent = String(stats.total ?? responseTotal ?? responses.length ?? 0);
			syncHistoryButtons();
			if (activeTab === "share") renderShare();
			if (activeTab === "responses") renderResponses();
		}
		function setTab(tab) { activeTab = tab; app.querySelectorAll('[role="tab"][data-tab]').forEach((button) => { const active = button.dataset.tab === tab; button.setAttribute("aria-selected", String(active)); button.tabIndex = active ? 0 : -1; }); app.querySelectorAll("[data-panel]").forEach((panel) => panel.hidden = panel.dataset.panel !== tab); if (tab === "share") renderShare(); if (tab === "responses") loadResponses(); }
		async function renderShare(published) {
			if (published) { currentForm = published.form || published; shareUrl = published.url || shareUrl; shortUrl = published.shortUrl || shortUrl; }
			const panel = $("#share-panel"); const slug = currentForm?.slug || ""; const isPublished = Boolean(slug || currentForm?.publishedVersion || currentForm?.published);
			const respondentAccess = currentForm?.publishedVersion?.respondentAccess || "public";
			const accessLabel = respondentAccess === "verified_email" ? "Verified email required" : "Anyone with the link";
			const accessHelp = respondentAccess === "verified_email" ? "Respondents sign in with a one-time email link before they can answer." : "Respondents can open and submit without signing in.";
			const url = shareUrl || (slug ? `${location.origin}/f/${slug}` : "");
			panel.innerHTML = `<div class="f-share-card"><section class="f-card f-share-main"><div class="f-panel-head"><span class="f-panel-icon">${icon("link", 20)}</span><div><h2>Share your form</h2><p class="f-muted">Publish it to create a link respondents can open on any device.</p></div>${url ? `<p class="f-status live">Published</p>` : ""}</div>${url ? `<label class="f-label" for="share-url">Form link</label><div class="f-inline-field"><input class="f-input" id="share-url" readonly value="${esc(url)}"><button type="button" class="f-btn secondary" data-action="copy-link">${icon("copy", 16)}Copy link</button><a class="f-btn secondary" target="_blank" rel="noopener" href="${esc(url)}">${icon("external", 16)}Open form</a></div>${shortUrl ? `<p class="f-short-link">${icon("link", 15)}<span>Short link: <a href="${esc(shortUrl)}" target="_blank" rel="noopener">${esc(shortUrl)}</a></span></p>` : ""}<div class="f-slug-block"><label class="f-label" for="form-slug">Form address</label><div class="f-inline-field"><span class="f-prefix-input"><span>/f/</span><input id="form-slug" class="f-input" value="${esc(slug)}" maxlength="50" pattern="[a-z0-9-]+" aria-label="Form link slug"></span><button type="button" class="f-btn secondary" data-action="save-slug">Save</button></div></div><div class="f-access-summary"><span>Who can respond</span><strong>${accessLabel}</strong><p>${accessHelp}</p><button type="button" class="f-btn secondary small" data-action="publish">Change access</button></div>` : `<div class="f-notice">This form has not been published yet. Choose who can respond when you publish.</div><button type="button" class="f-btn" data-action="publish">${icon("send", 15)}Publish form</button>`}<p class="f-muted f-fine">Keep editing any time. New responses use the latest published version.</p></section>${url ? `<section class="f-card f-qr-section"><h3>${icon("forms", 16)}QR code</h3><div id="share-qr" class="f-qr"></div><div class="f-qr-actions"><a id="qr-png" class="f-btn secondary small" download="urlx-form-qr.png" aria-disabled="true">${icon("download", 15)}Download PNG</a><a id="qr-svg" class="f-btn secondary small" download="urlx-form-qr.svg" aria-disabled="true">${icon("download", 15)}Download SVG</a><button type="button" class="f-btn secondary small" data-action="print">${icon("print", 15)}Print A4 / Save PDF</button></div></section>` : ""}</div>`;
			if (!url) return;
			try {
				const png = await renderQrPngDataUrl(url, { width:512, margin:2, color:{ dark:"#1d1d1f", light:"#ffffff" } });
				const svg = await renderQrSvg(url, { width:512, margin:2, color:{ dark:"#1d1d1f", light:"#ffffff" } });
				$("#share-qr").innerHTML = `<img src="${png}" width="216" height="216" alt="QR code for ${esc(draft.title)}">`;
				$("#qr-png").href = png;
				$("#qr-svg").href = URL.createObjectURL(new Blob([svg], { type:"image/svg+xml" }));
				$("#qr-png").removeAttribute("aria-disabled"); $("#qr-svg").removeAttribute("aria-disabled");
			} catch { $("#share-qr").textContent = "QR code could not be generated."; }
		}
		async function loadResponses() {
			try { const result = await formsRequest<{ responses?: unknown[]; stats?: unknown; total?: number }>(`/${encodeURIComponent(formId)}/responses`); responses = Array.isArray(result.responses) ? result.responses : []; stats = result.stats || {}; responseTotal = result.total ?? responses.length; renderResponses(); }
			catch (error) { $("#responses-panel").innerHTML = `<div class="f-card f-empty"><h2>Responses are unavailable</h2><p>${esc(error instanceof Error ? error.message : "Try again in a moment.")}</p><button class="f-btn secondary" data-action="responses-retry">Try again</button></div>`; }
		}
		const relativeTime = (value) => {
			const time = new Date(value).getTime();
			if (!Number.isFinite(time)) return "—";
			const seconds = Math.round((time - Date.now()) / 1000);
			const units = [["year", 31536000], ["month", 2592000], ["week", 604800], ["day", 86400], ["hour", 3600], ["minute", 60]];
			const format = new Intl.RelativeTimeFormat(undefined, { numeric:"auto" });
			for (const [unit, size] of units) if (Math.abs(seconds) >= size) return format.format(Math.round(seconds / size), unit);
			return "just now";
		};
		const answerText = (value) => Array.isArray(value) ? value.join(", ") : String(value ?? "");
		/** Merge per-version stats into one entry per question, newest labels first. */
		function questionSummaries() {
			const versions = (Array.isArray(stats) ? stats : []).slice().sort((a, b) => (b.version ?? 0) - (a.version ?? 0));
			const byId = new Map();
			for (const version of versions) {
				for (const field of version.fields || []) if (!byId.has(field.id)) byId.set(field.id, { field, answered:0, distribution:{}, ratingSum:0, ratingCount:0 });
				for (const question of version.questions || []) {
					const entry = byId.get(question.fieldId);
					if (!entry) continue;
					if (question.distribution) for (const [key, count] of Object.entries(question.distribution)) {
						entry.distribution[key] = (entry.distribution[key] || 0) + count;
						if (question.type === "rating") { entry.ratingSum += Number(key) * count; entry.ratingCount += count; }
					}
					if (typeof question.answered === "number") entry.answered += question.answered;
				}
			}
			for (const entry of byId.values()) {
				if (isChoice(entry.field.type)) entry.answered = responses.filter((response) => { const value = response?.answers?.[entry.field.id]; return Array.isArray(value) ? value.length : value !== undefined && value !== ""; }).length;
				if (entry.field.type === "rating") entry.answered = entry.ratingCount;
			}
			return [...byId.values()];
		}
		function bars(rows, total) {
			return `<div class="f-bars">${rows.map(([label, count]) => { const pct = total ? Math.round((count / total) * 100) : 0; return `<div class="f-bar"><div class="f-bar-label"><span>${esc(label)}</span><span class="f-muted">${count} · ${pct}%</span></div><div class="f-bar-track"><span style="width:${pct}%"></span></div></div>`; }).join("")}</div>`;
		}
		function summaryCard(entry, index) {
			const { field } = entry;
			const head = `<header class="f-sum-head"><span class="q-num">${index + 1}</span><div><h3>${esc(field.label || `Question ${index + 1}`)}</h3><p class="f-muted">${typeBadge(field.type)}<span>${entry.answered} of ${responseTotal} answered</span></p></div></header>`;
			let body = "";
			if (isChoice(field.type)) {
				const options = [...(field.options || []), ...Object.keys(entry.distribution).filter((key) => !(field.options || []).includes(key))];
				body = bars(options.map((option) => [option, entry.distribution[option] || 0]), field.type === "multichoice" ? entry.answered : Object.values(entry.distribution).reduce((sum, count) => sum + count, 0));
			} else if (field.type === "rating") {
				const average = entry.ratingCount ? entry.ratingSum / entry.ratingCount : 0;
				body = `<div class="f-rating-sum"><div class="f-rating-score"><strong>${entry.ratingCount ? average.toFixed(1) : "—"}</strong><span class="f-rating-stars" aria-label="${average.toFixed(1)} out of 5"><span>${icon("rating", 18).repeat(5)}</span><span class="fill" style="width:${(average / 5) * 100}%">${icon("rating", 18).repeat(5)}</span></span><small class="f-muted">average of ${entry.ratingCount}</small></div>${bars([5, 4, 3, 2, 1].map((n) => [`${n} star${n === 1 ? "" : "s"}`, entry.distribution[String(n)] || 0]), entry.ratingCount)}</div>`;
			} else {
				const answers = responses.map((response) => ({ value:answerText(response?.answers?.[field.id]), at:response?.createdAt })).filter((item) => item.value);
				body = answers.length ? `<ul class="f-answers">${answers.slice(0, 5).map((item) => `<li><span>${esc(item.value)}</span><time class="f-muted">${esc(relativeTime(item.at))}</time></li>`).join("")}</ul>${answers.length > 5 ? `<button type="button" class="q-add-option" data-action="responses-view" data-view="table">See all ${answers.length} answers</button>` : ""}` : `<p class="f-muted f-sum-empty">No answers yet.</p>`;
			}
			return `<article class="f-card f-sum">${head}${body}</article>`;
		}
		function responsesTable(entries) {
			const fields = entries.map((entry) => entry.field);
			const heads = fields.map((field) => `<th scope="col">${esc(field.label || field.id)}</th>`).join("");
			const versionNumbers = (Array.isArray(stats) ? stats : []).map((version) => Number(version.version)).filter(Number.isFinite);
			const latestVersion = versionNumbers.length ? Math.max(...versionNumbers) : null;
			const isOlder = (response) => latestVersion != null && response?.version != null && Number(response.version) < latestVersion;
			const multiVersion = responses.some(isOlder);
			const body = responses.map((response) => {
				const answers = response?.answers && typeof response.answers === "object" ? response.answers : {};
				const at = response?.createdAt || response?.at;
				const chip = isOlder(response) ? `<span class="f-version-chip" title="Submitted to an earlier version (v${esc(response.version)}) of this form">v${esc(response.version)}</span>` : "";
				const cells = fields.map((field) => { const value = answerText(answers[field.id]); return `<td>${value ? esc(value) : '<span class="f-muted">—</span>'}</td>`; }).join("");
				return `<tr><td><time title="${esc(at ? new Date(at).toLocaleString() : "")}">${esc(at ? relativeTime(at) : "—")}</time>${chip}</td>${cells}<td class="f-row-actions"><button type="button" class="f-icon-btn danger" data-action="delete-response" data-response="${esc(response?.id || "")}" aria-label="Delete response" title="Delete response">${icon("trash", 16)}</button></td></tr>`;
			}).join("");
			const versionNote = multiVersion ? `<p class="f-muted f-table-note">${icon("clock", 14)}Rows marked with a version were submitted before your latest publish. Their answers are kept as they were.</p>` : "";
			const more = responseTotal > responses.length ? `<p class="f-muted f-table-note">Showing the latest ${responses.length} of ${responseTotal}. Export CSV for everything.</p>` : "";
			return `<section class="f-card f-table-card"><p class="f-table-scroll-hint">Scroll horizontally to see all fields.</p><div class="f-table-scroll" tabindex="0" aria-label="Response table. Scroll horizontally to see all columns."><table class="f-response-table"><thead><tr><th scope="col">Received</th>${heads}<th><span class="f-sr">Actions</span></th></tr></thead><tbody>${body}</tbody></table></div>${versionNote}${more}</section>`;
		}
		function renderResponses() {
			const panel = $("#responses-panel");
			$("#response-count").textContent = String(responseTotal ?? 0);
			const weekAgo = Date.now() - 7 * 86400000;
			const thisWeek = responses.filter((response) => new Date(response?.createdAt).getTime() >= weekAgo).length;
			const latest = responses[0]?.createdAt;
			const kpis = `<div class="f-response-stats"><div class="f-card f-stat"><span class="f-stat-icon">${icon("inbox", 18)}</span><div><small>Responses</small><strong>${esc(responseTotal)}</strong></div></div><div class="f-card f-stat"><span class="f-stat-icon">${icon("date", 18)}</span><div><small>Last 7 days</small><strong>${esc(thisWeek)}</strong></div></div><div class="f-card f-stat"><span class="f-stat-icon">${icon("clock", 18)}</span><div><small>Latest</small><strong class="small">${esc(latest ? relativeTime(latest) : "—")}</strong></div></div></div>`;
			if (!responses.length) { panel.innerHTML = `${kpis}<div class="f-card f-empty"><span class="f-empty-icon">${icon("inbox", 26)}</span><h2>No responses yet</h2><p>Share your form and answers will show up here as charts and a table.</p><div class="f-empty-actions"><button type="button" class="f-btn" data-tab="share">${icon("link", 15)}Share form</button><button type="button" class="f-btn secondary" data-action="export" disabled>${icon("download", 15)}Export CSV</button></div></div>`; return; }
			const entries = questionSummaries();
			const toolbar = `<div class="f-responses-bar"><div class="f-tabs" role="group" aria-label="Response view"><button type="button" data-action="responses-view" data-view="summary" aria-pressed="${responsesView === "summary"}">${icon("rating", 15)}Summary</button><button type="button" data-action="responses-view" data-view="table" aria-pressed="${responsesView === "table"}">${icon("paragraph", 15)}Table</button></div><button type="button" class="f-btn secondary small" data-action="export">${icon("download", 15)}Export CSV</button></div>`;
			const view = responsesView === "table" ? responsesTable(entries) : `<div class="f-sum-grid">${entries.map(summaryCard).join("")}</div>`;
			panel.innerHTML = `${kpis}${toolbar}${view}`;
		}
		function preview() {
			$("#preview-content").innerHTML = previewFormMarkup({ ...draft, accent:draft.accent }, "preview-");
			$("#preview-content").classList.remove("phone");
			$("#preview-dialog").showModal();
		}
		async function publish() {
			const button = app.querySelector('[data-action="publish"]'); if (button) button.disabled = true;
			try {
				const currentAccess = pendingRespondentAccess || currentForm?.publishedVersion?.respondentAccess;
				const respondentAccess = await chooseRespondentAccess(currentAccess);
				if (!respondentAccess) return;
				pendingRespondentAccess = respondentAccess;
				if (!(await flushDraft())) {
					showToast(pendingConflict ? "Resolve the draft conflict before publishing." : "Could not save your latest changes. Try publishing again when the save succeeds.", { tone:"error" });
					return;
				}
				const result = await formsRequest<{ form?: FormRecord; version?: unknown; url?: string; slug?: string }>(`/${encodeURIComponent(formId)}/publish`, { method:"POST", body:JSON.stringify({ respondentAccess }) }); pendingRespondentAccess = null; renderShare(result); setTab("share"); showToast("Your form is published", { tone:"success" });
			}
			catch (error) { showToast(errorMessage(error, "Could not publish this form."), { tone:"error" }); }
			finally { if (button) button.disabled = false; }
		}
		app.addEventListener("click", async (event) => {
			const tab = event.target.closest("[data-tab]"); if (tab) { setTab(tab.dataset.tab); return; }
			const action = event.target.closest("[data-action]"); if (!action) { selectCard(event.target.closest("[data-field]")); return; }
			const card = action.closest("[data-field]"); const index = card ? draft.fields.findIndex((field) => field.id === card.dataset.field) : -1; const field = index >= 0 ? draft.fields[index] : null;
			switch (action.dataset.action) {
				case "accent": edit(() => { draft.accent = action.dataset.accent; }, true); break;
				case "add": { const next = newField(action.dataset.type); edit(() => { draft.fields.push(next); selected = next.id; }, true); break; }
				case "required": if (field) edit(() => { field.required = !field.required; }, true); break;
				case "add-option": if (field) edit(() => field.options.push(`Option ${field.options.length + 1}`), true); break;
				case "remove-option": if (field) edit(() => field.options.splice(Number(action.dataset.option), 1), true); break;
				case "up": case "down": if (field) { const to = index + (action.dataset.action === "up" ? -1 : 1); if (to >= 0 && to < draft.fields.length) edit(() => { [draft.fields[index], draft.fields[to]] = [draft.fields[to], draft.fields[index]]; }, true); } break;
				case "duplicate": if (field) { const duplicate = { ...clone(field), id:crypto.randomUUID(), label:`${field.label} (copy)` }; edit(() => { draft.fields.splice(index + 1, 0, duplicate); selected = duplicate.id; }, true); } break;
				case "delete": if (field) { edit(() => { draft.fields.splice(index, 1); selected = draft.fields[Math.min(index, draft.fields.length - 1)]?.id || ""; }, true); showToast(`Deleted “${field.label || "Untitled question"}”`, { action:{ label:"Undo", onClick:() => app.querySelector('[data-action="undo"]')?.click() } }); } break;
				case "undo": case "redo": { const delta = action.dataset.action === "undo" ? -1 : 1; const next = historyIndex + delta; if (next >= 0 && next < history.length) { historyIndex = next; draft = JSON.parse(history[historyIndex]); render(); queueSave(); } break; }
				case "preview": preview(); break;
				case "preview-device": $("#preview-content").classList.toggle("phone", action.dataset.device === "phone"); app.querySelectorAll('[data-action="preview-device"]').forEach((button) => button.setAttribute("aria-pressed", String(button === action))); break;
				case "publish": await publish(); break;
				case "save-slug": { const saveButton = action; saveButton.disabled = true; try { const result = await formsRequest<{ form?: FormRecord; url?: string; shortUrl?: string }>(`/${encodeURIComponent(formId)}/slug`, { method:"POST", body:JSON.stringify({ slug:$("#form-slug").value }) }); currentForm = result.form || currentForm; shareUrl = result.url || shareUrl; shortUrl = result.shortUrl || shortUrl; await renderShare(result); showToast("Form address updated", { tone:"success" }); } catch (error) { showToast(errorMessage(error, "Could not update the address."), { tone:"error" }); saveButton.disabled = false; } break; }
				case "copy-link": try { await navigator.clipboard.writeText($("#share-url").value); showToast("Link copied"); } catch { $("#share-url").select(); document.execCommand("copy"); showToast("Link copied"); } break;
				case "print": window.print(); break;
				case "responses-retry": loadResponses(); break;
				case "resolve-conflict": await resolveConflict(action.dataset.resolution); break;
				case "responses-view": responsesView = action.dataset.view; renderResponses(); break;
				case "export": window.location.assign(`/api/forms/${encodeURIComponent(formId)}/export.csv`); break;
				case "delete-response": { const responseId = action.dataset.response; if (!(await confirmAction({ title:"Delete this response?", message:"The answers will be removed permanently and can’t be recovered.", confirmLabel:"Delete response", danger:true }))) break; action.disabled = true; try { await formsRequest(`/${encodeURIComponent(formId)}/responses/${encodeURIComponent(responseId)}`, { method:"DELETE" }); await loadResponses(); showToast("Response deleted"); } catch (error) { action.disabled = false; showToast(errorMessage(error, "Could not delete this response."), { tone:"error" }); } break; }
			}
		});
		app.addEventListener("keydown", (event) => {
			const current = event.target.closest?.('[role="tab"][data-tab]');
			if (!current) return;
			const tabs = [...app.querySelectorAll('[role="tab"][data-tab]')];
			const index = tabs.indexOf(current);
			const nextIndex = event.key === "ArrowRight" ? (index + 1) % tabs.length : event.key === "ArrowLeft" ? (index - 1 + tabs.length) % tabs.length : event.key === "Home" ? 0 : event.key === "End" ? tabs.length - 1 : -1;
			if (nextIndex < 0) return;
			event.preventDefault();
			tabs[nextIndex].focus();
			setTab(tabs[nextIndex].dataset.tab);
		});
		function selectCard(card) { if (!card || selected === card.dataset.field) return; selected = card.dataset.field; app.querySelectorAll(".f-question").forEach((item) => item.classList.toggle("selected", item === card)); }
		// Keyboard users get the same focus mode as clicks: focusing a question selects it.
		app.addEventListener("focusin", (event) => selectCard(event.target.closest?.("[data-field]")));
		app.addEventListener("input", (event) => {
			const input = event.target;
			if (input.id === "draft-title") { draft.title = input.value; $("#form-title-label").textContent = input.value || "Untitled form"; queueSave(); return; }
			if (input.id === "draft-description") { draft.description = input.value; queueSave(); return; }
			if (input.id === "draft-confirmation") { draft.confirmationMessage = input.value; queueSave(); return; }
			const card = input.closest("[data-field]"); const field = card && draft.fields.find((item) => item.id === card.dataset.field); if (!field) return;
			if (input.dataset.key === "label") field.label = input.value;
			if (input.dataset.key === "help") field.help = input.value;
			if (input.dataset.key === "option") field.options[Number(input.dataset.option)] = input.value;
			queueSave();
		});
		app.addEventListener("change", (event) => {
			const select = event.target.closest('[data-action="type-select"]');
			if (!select) return;
			const card = select.closest("[data-field]");
			const field = card && draft.fields.find((item) => item.id === card.dataset.field);
			if (!field) return;
			edit(() => {
				field.type = select.value;
				if (["singlechoice", "multichoice"].includes(field.type) && !field.options?.length) field.options = ["Option 1", "Option 2"];
				selected = field.id;
			}, true);
		});
		document.addEventListener("keydown", (event) => {
			if (event.isComposing || event.target.closest("textarea,[contenteditable=true]") || activeTab !== "build") return;
			const target = event.target;
			const targetField = target.closest("[data-field]");
			if (event.key === "Enter" && target.matches(".q-label")) { event.preventDefault(); const field = draft.fields.find((item) => item.id === targetField?.dataset.field); if (field) { const next = newField(field.type); edit(() => { draft.fields.splice(draft.fields.indexOf(field) + 1, 0, next); selected = next.id; }, true); requestAnimationFrame(() => app.querySelector(`[data-field="${next.id}"] .q-label`)?.focus()); } return; }
			if (event.key === "Backspace" && target.matches(".q-label") && target.value === "" && draft.fields.length > 1) { event.preventDefault(); const index = draft.fields.findIndex((field) => field.id === targetField?.dataset.field); edit(() => { draft.fields.splice(index, 1); selected = draft.fields[Math.max(0, index - 1)]?.id || ""; }, true); return; }
			if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "z") { event.preventDefault(); const action = app.querySelector(`[data-action="${event.shiftKey ? "redo" : "undo"}"]`); action?.click(); }
			if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "d") { event.preventDefault(); const action = app.querySelector(`[data-field="${selected}"] [data-action="duplicate"]`); action?.click(); }
			if (event.altKey && ["ArrowUp", "ArrowDown"].includes(event.key)) { event.preventDefault(); app.querySelector(`[data-field="${selected}"] [data-action="${event.key === "ArrowUp" ? "up" : "down"}"]`)?.click(); }
		});
		async function init() {
			try {
				const result = await formsRequest<{ form?: FormRecord; draft?: unknown; revision?: number; versions?: unknown[]; usage?: unknown }>(`/${encodeURIComponent(formId)}`);
				currentForm = result.form || {};
				shareUrl = result.form?.url || (result.form?.slug ? `${location.origin}/f/${result.form.slug}` : "");
				shortUrl = result.form?.shortUrl || (result.form?.shortCode ? `${location.origin}/u/${result.form.shortCode}` : "");
				draft = normalizeDraft(result.draft || result.form?.draft || result.form, result.form?.title || "Untitled form");
				const serverDraft = draft;
				revision = result.revision ?? 0;
				responseTotal = Number(result.form?.responseCount ?? 0);
				selected = draft.fields[0]?.id || "";
				let recoverCached = false;
				let staleCached = false;
				try {
					const cached = JSON.parse(localStorage.getItem(localKey) || "null");
					if (cached?.draft) {
						const cachedDraft = normalizeDraft(cached.draft);
						if (JSON.stringify(cachedDraft) === JSON.stringify(serverDraft)) localStorage.removeItem(localKey);
						else {
							draft = cachedDraft;
							editVersion = Number.isInteger(cached.editVersion) && cached.editVersion > 0 ? cached.editVersion : 1;
							recoverCached = cached.revision === revision;
							staleCached = !recoverCached;
						}
					}
				} catch {}
				renderStatic(); snapshot(); render(); app.inert = false; app.removeAttribute("aria-busy"); app.dataset.ready = "true";
				if (staleCached) showConflict(serverDraft, revision, "A newer version of this form is already saved. Reload it, or review the conflict before overwriting it.");
				else if (recoverCached) {
					if (navigator.onLine) void flushDraft();
					else showLocalSaveState();
				}
				// Fill in the Responses badge without waiting for the tab to open.
				loadResponses();
			} catch (error) {
				$("#editor-alert").hidden = false; $("#editor-alert").textContent = error instanceof Error ? error.message : "Could not load this form.";
				$("#form-title-label").textContent = "Form unavailable";
				app.inert = false; app.removeAttribute("aria-busy"); app.dataset.ready = "true";
			}
		}
		init();
		}
	</script>
</Layout>
