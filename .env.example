# Copy to .env and replace the empty values. The runtime Compose file fails
# closed until public URLs, secrets, and the host-generated egress policy exist.

# Public URLs are embedded in the browser bundle at build time. Use the same
# origin for the site and API; conversion is routed under /convert.
PUBLIC_ORIGIN=
PUBLIC_SERVER_URL=
PUBLIC_CONVERSION_SERVER_URL=

# Enter the portion of host RAM/CPU you are willing to allocate to URLX.
# The preflight sums service cgroup caps and rejects totals above these budgets.
URLX_HOST_MEMORY_BUDGET_BYTES=
URLX_HOST_CPU_BUDGET=
WEB_MEMORY_LIMIT=
WEB_CPU_LIMIT=
API_MEMORY_LIMIT=
API_CPU_LIMIT=
CONVERSION_MEMORY_LIMIT=
CONVERSION_CPU_LIMIT=
CONVERSION_RENDERER_MEMORY_LIMIT=
CONVERSION_RENDERER_CPU_LIMIT=
POSTGRES_MEMORY_LIMIT=
POSTGRES_CPU_LIMIT=
MIGRATOR_MEMORY_LIMIT=
MIGRATOR_CPU_LIMIT=
EGRESS_PROXY_MEMORY_LIMIT=
EGRESS_PROXY_CPU_LIMIT=
CADDY_MEMORY_LIMIT=
CADDY_CPU_LIMIT=

# Use independent random hex passwords. URL-encode them in the connection URLs
# below if you choose characters outside [A-Za-z0-9].
POSTGRES_BOOTSTRAP_PASSWORD=
# Database name may be changed, but must match both connection URLs below.
POSTGRES_DB=urlx
URLX_APP_PASSWORD=
URLX_MIGRATOR_PASSWORD=
DATABASE_URL=
MIGRATOR_DATABASE_URL=
PG_POOL_MAX=
# Enter byte counts. Keep Valkey's maxmemory at least 20% below its container limit.
VALKEY_MAXMEMORY=
VALKEY_MEMORY_LIMIT=
VALKEY_CPU_LIMIT=

# 32 random bytes, base64 encoded. Keep all secrets in the ignored .env file.
VISITOR_TOKEN_KEY_BASE64=

# Forms is disabled unless all auth/mail values are configured. Generate the
# Better Auth secret with a CSPRNG, for example `openssl rand -base64 32`.
FORMS_ENABLED=false
BETTER_AUTH_SECRET=
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Set renderer concurrency and cgroup caps after measuring this host. The
# preflight requires a minimum budget per browser context; it is not a sizing
# guarantee. The renderer also has a bounded restart policy.
CONVERSION_BROWSER_DISABLED=false
RENDERER_CONCURRENCY=
RENDERER_MAX_QUEUE=1
RENDERER_QUEUE_TIMEOUT_MS=5000

# Optional loopback-only HTTP port for the ingress profile.
INGRESS_BIND_ADDRESS=127.0.0.1
INGRESS_HTTP_PORT=8080
