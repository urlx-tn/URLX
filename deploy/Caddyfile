:8080 {
	@api path /rpc* /visitor-token /api-reference* /api/forms /api/forms/* /api/auth/*
	handle @api {
		reverse_proxy api:8787 {
			header_up X-Urlx-Client-IP {remote_host}
		}
	}

	@conversion path /convert/*
	handle_path @conversion {
		reverse_proxy conversion:8788 {
			header_up X-Urlx-Client-IP {remote_host}
		}
	}

	handle {
		reverse_proxy web:8080 {
			header_up X-Urlx-Client-IP {remote_host}
		}
	}
}
